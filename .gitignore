# ==============================================================================
# F.O.R.G.E. Website — Root .gitignore
# ==============================================================================

# Node / Frontend Build
node_modules/
dist/
dist-ssr/
*.local
.vite/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python & Virtual Environments
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.oxlintrc.cache

# Environment Variables & Secrets (MANDATORY SECURITY BASELINE)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
secrets/

# Databases
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite3-journal

# Local Job Data, Uploads & Reconstruction Intermediates (MANDATORY OUT-OF-TREE)
/data/
/uploads/
/jobs/
/outputs/
/intermediates/
/temp/
/tmp/
/runs/
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Large Model Weights & Checkpoints
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.ckpt
*.weights

# Heavy 3D Assets (Generated models must stay outside Git)
# Allow only explicit development fixture models in sample directories
*.obj
*.ply
*.glb
*.gltf
*.mtl
*.fbx
!src/assets/fixtures/*
!viewer/src/assets/fixtures/*
!viewer/public/sample/*

# Server Logs & Runtime Dumps
*.log
logs/
*.pid

# OS & Editor Specific
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

