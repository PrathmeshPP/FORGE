# ==============================================================================
# F.O.R.G.E. Website — Local Host Configuration Template (.env.example)
# Copy to .env for local runtime configuration. Never commit .env to Git.
# ==============================================================================

# Server Network Binding (Loopback only for private Tailscale Serve)
HOST=127.0.0.1
PORT=8000

# Pipeline Integration Root (Path to local read-only FORGE repository checkout)
# Example: FORGE_PIPELINE_ROOT=C:\Users\25beevdt025\Desktop\FORGE
FORGE_PIPELINE_ROOT=

# Dedicated Local Data Storage (MUST be outside Git and NOT cloud-synced like OneDrive)
# Example: FORGE_DATA_DIR=C:\forge_data
FORGE_DATA_DIR=

# Reconstruction Worker Mode: 'mock' (default for v1 development) or 'real'
FORGE_WORKER_MODE=mock

# Resource Limits & Safety Gates
FORGE_MAX_UPLOAD_BYTES=2147483648
FORGE_MAX_VIDEO_SECONDS=900
FORGE_MAX_ACTIVE_JOBS=1
FORGE_MAX_QUEUE_SIZE=5
FORGE_JOB_TIMEOUT_SECONDS=1800
FORGE_MIN_FREE_DISK_PERCENT=10.0
FORGE_RAW_RETENTION_HOURS=24
FORGE_LOG_LEVEL=INFO

